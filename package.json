{
  "name": "deepseek-adapter",
  "version": "1.0.0",
  "description": "Use DeepSeek models with Claude Code - An Anthropic-compatible API adapter",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "deepseek-adapter": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./converters": "./src/converters/index.js"
  },
  "scripts": {
    "start": "node bin/cli.js start",
    "dev": "node --watch bin/cli.js start",
    "test": "node tests/test.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "deepseek",
    "anthropic",
    "openai-compatible",
    "proxy",
    "adapter"
  ],
  "author": "Tie Zi",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/renyanfeng/deepseek-adapter.git"
  },
  "homepage": "https://github.com/renyanfeng/deepseek-adapter#readme"
}
