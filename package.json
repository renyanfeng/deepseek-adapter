{
  "name": "deepseek-adapter",
  "version": "1.0.2",
  "description": "Use DeepSeek models with Claude Code - An Anthropic-compatible API adapter",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "deepseek-adapter": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./types/index.d.ts",
      "default": "./src/server.js"
    },
    "./converters": {
      "types": "./types/index.d.ts",
      "default": "./src/converters/index.js"
    }
  },
  "scripts": {
    "start": "node bin/cli.js start",
    "dev": "node --watch bin/cli.js start",
    "test": "node tests/test.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "deepseek",
    "anthropic",
    "openai-compatible",
    "proxy",
    "adapter"
  ],
  "author": "Tie Zi",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/renyanfeng/deepseek-adapter.git"
  },
  "homepage": "https://github.com/renyanfeng/deepseek-adapter#readme",
  "files": [
    "src/",
    "bin/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
